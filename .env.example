# Run `server-control-mcp init` to generate real secrets; do not use placeholders.
CODING_TOOLS_MCP_SERVER_URL=https://mcp.example.com
CODING_TOOLS_MCP_OAUTH_PASSWORD=GENERATE_WITH_INIT
CODING_TOOLS_MCP_OAUTH_TOKEN_SECRET=GENERATE_WITH_INIT
CODING_TOOLS_MCP_OAUTH_TOKEN_TTL=3600
SCM_STATE_DIR=./state
SCM_WORKSPACE=./workspace
SCM_BACKEND_PORT=28766
SCM_GATEWAY_PORT=28767
SCM_PERMISSION_MODE=safe
SCM_EVENTS_ENABLED=0
