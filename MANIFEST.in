include LICENSE NOTICE README.md README.en.md CHANGELOG.md SECURITY.md CONTRIBUTING.md .env.example Dockerfile compose.yaml
include .gitignore .dockerignore
recursive-include .github *.yml
recursive-include docs *.md
recursive-include deploy *.service
recursive-include scripts *.py
recursive-include tests *.py
recursive-exclude * __pycache__ *.pyc *.sqlite3 *.token
